{
  "expo": {
    "name": "VitalGaze",
    "slug": "vitalgaze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/VitalGaze01.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.clouds68.vitalgaze",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothAlwaysUsageDescription": "VitalGaze uses Bluetooth to connect to your eye-tracking device.",
        "NSBluetoothPeripheralUsageDescription": "VitalGaze uses Bluetooth to connect to your eye-tracking device."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.clouds68.vitalgaze",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-screen-orientation",
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "owner": "clouds68",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "11a3c1ea-d781-4667-b3f9-bac40342cf22"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/11a3c1ea-d781-4667-b3f9-bac40342cf22"
    }
  }
}
